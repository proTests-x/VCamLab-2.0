<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>items</key>
    <array>
        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>VirtualCamPro</string>
            <key>footerText</key>
            <string>Selecciona primero una fuente y completa los grupos que aparezcan. Los parámetros de red dependen de OBS o del emisor; la rotación, el reflejo, los FPS y la calidad solo afectan al contenido local del iPhone.</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>default</key><false/>
            <key>defaults</key><string>com.murkaska.virtualcampro</string>
            <key>key</key><string>enabled</string>
            <key>label</key><string>Activar reemplazo de la cámara del sistema</string>
            <key>PostNotification</key><string>com.murkaska.virtualcampro/preferences.changed</string>
        </dict>
        <dict>
            <key>cell</key><string>PSLinkListCell</string>
            <key>detail</key><string>PSListItemsController</string>
            <key>default</key><integer>0</integer>
            <key>defaults</key><string>com.murkaska.virtualcampro</string>
            <key>key</key><string>sourceType</string>
            <key>label</key><string>Fuente de reemplazo</string>
            <key>validTitles</key>
            <array>
                <string>HLS / MJPEG de red</string>
                <string>Duplicación de pantalla en tiempo real</string>
                <string>Video / audio local del iPhone</string>
            </array>
            <key>validValues</key>
            <array><integer>0</integer><integer>1</integer><integer>2</integer></array>
            <key>PostNotification</key><string>com.murkaska.virtualcampro/preferences.changed</string>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>label</key><string>Configuración actual</string>
            <key>get</key><string>currentSourceConfigurationSummary:</string>
            <key>vcConfigurationStatus</key><true/>
        </dict>
        <dict>
            <key>cell</key><string>PSButtonCell</string>
            <key>label</key><string>Ver instrucciones de la fuente actual</string>
            <key>action</key><string>showCurrentSourceGuide:</string>
        </dict>

        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>Transmisión de red</string>
            <key>vcSourceTypes</key><array><integer>0</integer></array>
            <key>footerText</key><string>Se recomienda MJPEG para obtener la menor latencia. El iPhone solo decodifica los fotogramas completos del emisor; todos los parámetros de imagen dependen de Windows/OBS.</string>
        </dict>
        <dict>
            <key>cell</key><string>PSEditTextCell</string>
            <key>default</key><string></string>
            <key>defaults</key><string>com.murkaska.virtualcampro</string>
            <key>key</key><string>streamURL</string>
            <key>label</key><string>URL de transmisión</string>
            <key>placeholder</key><string>http://192.168.1.10:8888/live.mjpg</string>
            <key>vcSourceTypes</key><array><integer>0</integer></array>
            <key>PostNotification</key><string>com.murkaska.virtualcampro/preferences.changed</string>
        </dict>
        <dict>
            <key>cell</key><string>PSButtonCell</string>
            <key>label</key><string>Probar transmisión actual</string>
            <key>action</key><string>testStreamConnection:</string>
            <key>vcSourceTypes</key><array><integer>0</integer></array>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>label</key><string>Punto de conexión</string>
            <key>get</key><string>currentNetworkEndpointSummary:</string>
            <key>vcSourceTypes</key><array><integer>0</integer></array>
            <key>vcConfigurationStatus</key><true/>
        </dict>

        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>Duplicación de pantalla</string>
            <key>vcSourceTypes</key><array><integer>1</integer></array>
            <key>footerText</key><string>La fuente de pantalla usa directamente la orientación y frecuencia de actualización del dispositivo; no utiliza la rotación, el reflejo, la calidad ni los FPS del video local.</string>
        </dict>

        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>Contenido local del iPhone</string>
            <key>vcSourceTypes</key><array><integer>2</integer></array>
            <key>footerText</key><string>Puedes seleccionar varios videos o audios desde Archivos, o varios videos desde Fotos. Se copiarán a /var/mobile/Media/VirtualCamPro/; si hay al menos dos videos, usa volumen +/− para cambiar al siguiente o anterior durante la reproducción.</string>
        </dict>
        <dict>
            <key>cell</key><string>PSButtonCell</string>
            <key>label</key><string>Seleccionar video / audio local</string>
            <key>action</key><string>chooseLocalMedia:</string>
            <key>vcSourceTypes</key><array><integer>2</integer></array>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>defaults</key><string>com.murkaska.virtualcampro</string>
            <key>key</key><string>localMediaPath</string>
            <key>label</key><string>Contenido actual</string>
            <key>get</key><string>currentLocalMediaName:</string>
            <key>vcSourceTypes</key><array><integer>2</integer></array>
            <key>PostNotification</key><string>com.murkaska.virtualcampro/preferences.changed</string>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>label</key><string>Lista controlada por volumen</string>
            <key>get</key><string>currentLocalVideoPlaylistSummary:</string>
            <key>vcSourceTypes</key><array><integer>2</integer></array>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>label</key><string>Biblioteca importada</string>
            <key>get</key><string>currentLocalMediaLibrarySummary:</string>
            <key>vcSourceTypes</key><array><integer>2</integer></array>
        </dict>
        <dict>
            <key>cell</key><string>PSButtonCell</string>
            <key>label</key><string>Ver biblioteca local</string>
            <key>action</key><string>showLocalMediaLibrary:</string>
            <key>vcSourceTypes</key><array><integer>2</integer></array>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>label</key><string>Estado del hook de volumen</string>
            <key>get</key><string>currentLocalVolumeHookStatus:</string>
            <key>vcSourceTypes</key><array><integer>2</integer></array>
            <key>vcLiveStatus</key><true/>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>label</key><string>Estado de transformación de SpringBoard</string>
            <key>get</key><string>currentLocalTransformStatus:</string>
            <key>vcSourceTypes</key><array><integer>2</integer></array>
            <key>vcLiveStatus</key><true/>
        </dict>
        <dict>
            <key>cell</key><string>PSButtonCell</string>
            <key>label</key><string>Borrar selección actual</string>
            <key>action</key><string>clearLocalMedia:</string>
            <key>vcSourceTypes</key><array><integer>2</integer></array>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>default</key><true/>
            <key>defaults</key><string>com.murkaska.virtualcampro</string>
            <key>key</key><string>loopLocalMedia</string>
            <key>label</key><string>Repetir contenido local actual</string>
            <key>vcSourceTypes</key><array><integer>2</integer></array>
            <key>PostNotification</key><string>com.murkaska.virtualcampro/preferences.changed</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSliderCell</string>
            <key>default</key><integer>60</integer>
            <key>defaults</key><string>com.murkaska.virtualcampro</string>
            <key>key</key><string>preferredFPS</string>
            <key>label</key><string>FPS máximos del video local</string>
            <key>min</key><integer>1</integer>
            <key>max</key><integer>240</integer>
            <key>showValue</key><true/>
            <key>vcSourceTypes</key><array><integer>2</integer></array>
            <key>PostNotification</key><string>com.murkaska.virtualcampro/preferences.changed</string>
        </dict>
        <dict>
            <key>cell</key><string>PSLinkListCell</string>
            <key>detail</key><string>PSListItemsController</string>
            <key>default</key><integer>1920</integer>
            <key>defaults</key><string>com.murkaska.virtualcampro</string>
            <key>key</key><string>maximumPixelDimension</string>
            <key>label</key><string>Calidad de decodificación local</string>
            <key>validTitles</key>
            <array>
                <string>1280 (ahorro de energía)</string><string>1920 (recomendado)</string>
                <string>2560 (alta definición)</string><string>3840 (ultra alta definición)</string>
            </array>
            <key>validValues</key>
            <array><integer>1280</integer><integer>1920</integer><integer>2560</integer><integer>3840</integer></array>
            <key>vcSourceTypes</key><array><integer>2</integer></array>
            <key>PostNotification</key><string>com.murkaska.virtualcampro/preferences.changed</string>
        </dict>
        <dict>
            <key>cell</key><string>PSLinkListCell</string>
            <key>detail</key><string>PSListItemsController</string>
            <key>default</key><integer>0</integer>
            <key>defaults</key><string>com.murkaska.virtualcampro</string>
            <key>key</key><string>sourceRotation</string>
            <key>label</key><string>Rotación del video local</string>
            <key>validTitles</key>
            <array><string>Sin rotación</string><string>90° a la derecha</string><string>Girar 180°</string><string>90° a la izquierda</string></array>
            <key>validValues</key>
            <array><integer>0</integer><integer>90</integer><integer>180</integer><integer>270</integer></array>
            <key>vcSourceTypes</key><array><integer>2</integer></array>
            <key>PostNotification</key><string>com.murkaska.virtualcampro/preferences.changed</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>default</key><false/>
            <key>defaults</key><string>com.murkaska.virtualcampro</string>
            <key>key</key><string>mirrorSource</string>
            <key>label</key><string>Reflejar horizontalmente el video local</string>
            <key>vcSourceTypes</key><array><integer>2</integer></array>
            <key>PostNotification</key><string>com.murkaska.virtualcampro/preferences.changed</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>default</key><true/>
            <key>defaults</key><string>com.murkaska.virtualcampro</string>
            <key>key</key><string>aspectFill</string>
            <key>label</key><string>Rellenar pantalla con el video local</string>
            <key>vcSourceTypes</key><array><integer>2</integer></array>
            <key>PostNotification</key><string>com.murkaska.virtualcampro/preferences.changed</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSliderCell</string>
            <key>default</key><real>1.0</real>
            <key>defaults</key><string>com.murkaska.virtualcampro</string>
            <key>key</key><string>jpegQuality</string>
            <key>label</key><string>Calidad JPEG de fotos del contenido local</string>
            <key>min</key><real>0.5</real>
            <key>max</key><real>1.0</real>
            <key>showValue</key><true/>
            <key>vcSourceTypes</key><array><integer>2</integer></array>
            <key>PostNotification</key><string>com.murkaska.virtualcampro/preferences.changed</string>
        </dict>

        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>Estado y recuperación</string>
            <key>footerText</key><string>El estado se actualiza cada segundo mientras esta página está visible y se detiene al salir. La canalización del sistema solo aparece activa cuando una aplicación captura video; el diagnóstico no desactiva la ruta alternativa por muestra de ninguna CaptureSession.</string>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>label</key><string>Estado de la fuente</string>
            <key>get</key><string>currentSourceRuntimeStatus:</string>
            <key>vcLiveStatus</key><true/>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>label</key><string>Bus de video compartido</string>
            <key>get</key><string>currentSharedVideoBusStatus:</string>
            <key>vcLiveStatus</key><true/>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>label</key><string>Canalización de video del sistema</string>
            <key>get</key><string>currentSystemVideoPipelineStatus:</string>
            <key>vcLiveStatus</key><true/>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>label</key><string>Canalización alternativa de la aplicación</string>
            <key>get</key><string>currentApplicationFallbackStatus:</string>
            <key>vcLiveStatus</key><true/>
        </dict>
        <dict>
            <key>cell</key><string>PSButtonCell</string>
            <key>label</key><string>Recargar fuente actual</string>
            <key>action</key><string>reloadCurrentSource:</string>
        </dict>
        <dict>
            <key>cell</key><string>PSButtonCell</string>
            <key>label</key><string>Copiar diagnóstico de ejecución</string>
            <key>action</key><string>copyRuntimeDiagnostics:</string>
        </dict>

        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>Estabilidad</string>
            <key>footerText</key><string>La protección ante interrupciones solo determina qué ocurre cuando caduca el fotograma de reemplazo; cualquier fallo de decodificación o nodo privado conserva la ruta original de cámara y micrófono.</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>default</key><true/>
            <key>defaults</key><string>com.murkaska.virtualcampro</string>
            <key>key</key><string>holdLastFrame</string>
            <key>label</key><string>Conservar el último fotograma al interrumpirse</string>
            <key>PostNotification</key><string>com.murkaska.virtualcampro/preferences.changed</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSliderCell</string>
            <key>default</key><real>8.0</real>
            <key>defaults</key><string>com.murkaska.virtualcampro</string>
            <key>key</key><string>staleFrameTimeout</string>
            <key>label</key><string>Caducidad del fotograma (segundos)</string>
            <key>min</key><real>2.0</real>
            <key>max</key><real>30.0</real>
            <key>showValue</key><true/>
            <key>PostNotification</key><string>com.murkaska.virtualcampro/preferences.changed</string>
        </dict>
        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>Acerca de</string>
            <key>footerText</key><string>VirtualCamPro reemplaza muestras multimedia L2–L5; no suplanta dispositivos de cámara, componentes de Apple ni sensores. La compatibilidad final de BWNodeOutput debe comprobarse en el dispositivo iOS de destino.</string>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>label</key><string>Versión del plugin</string>
            <key>get</key><string>currentPackageVersion:</string>
        </dict>
    </array>
    <key>title</key><string>VirtualCamPro</string>
</dict>
</plist>
